<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_create_task_wizard" model="ir.ui.view">
        <field name="name">et.create.task.wizard.form</field>
        <field name="model">et.create.task.wizard</field>

        <field name="arch" type="xml">

            <form string="Create Tasks">

                <group>

                    <field name="task_title"/>

                    <field
                        name="task_description"
                        widget="html"/>

                </group>

                <footer>

                    <button
                        name="action_create_tasks"
                        string="Create"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>