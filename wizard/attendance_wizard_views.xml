<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_et_attendance_wizard_form" model="ir.ui.view">
        <field name="name">et.attendance.wizard.form</field>
        <field name="model">et.attendance.wizard</field>
        <field name="arch" type="xml">

            <form string="Take Attendance">

                <sheet>

                    <group>
                        <field name="session_id" readonly="1"/>
                        <field name="attendance_date"/>
                    </group>

                    <field name="line_ids" nolabel="1">

                        <list editable="bottom"
                              create="0"
                              delete="0">

                            <field name="trainee_employee_id"
                                   readonly="1"/>

                            <field name="status"/>

                        </list>

                    </field>

                </sheet>

                <footer>

                    <button name="action_save_attendance"
                            type="object"
                            string="Save Attendance"
                            class="btn btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

</odoo>