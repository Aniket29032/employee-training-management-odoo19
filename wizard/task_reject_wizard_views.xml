<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record
        id="view_task_reject_wizard_form" model="ir.ui.view">

        <field name="name">task.reject.wizard.form</field>

        <field name="model">task.reject.wizard</field>

        <field name="arch" type="xml">

            <form string="Reject Task">

                <sheet>

                    <field
                        name="task_id"
                        invisible="1"/>

                    <field
                        name="review_comment"
                        widget="html"/>

                </sheet>

                <footer>

                    <button
                        name="action_confirm"
                        type="object"
                        string="Reject"
                        class="btn-danger"/>

                    <button
                        string="Cancel"
                        special="cancel"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>