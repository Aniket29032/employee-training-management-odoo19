<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_employee_form_training" model="ir.ui.view">
        <field name="name">hr.employee.form.training</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='company_id']" position="after">
                <field name="is_trainer" invisible="is_training_admin" />
                <field name="is_training_admin"/>
                <field name="is_trainee"/>
            </xpath>

        </field>

    </record>

</odoo>