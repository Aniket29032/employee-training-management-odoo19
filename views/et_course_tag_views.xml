<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- List View -->
    <record id="view_et_course_tag_list" model="ir.ui.view">
        <field name="name">et.course.tags.list</field>
        <field name="model">et.course.tags</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_et_course_tag_form" model="ir.ui.view">
        <field name="name">et.course.tags.form</field>
        <field name="model">et.course.tags</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_et_course_tag_search" model="ir.ui.view">
        <field name="name">et.course.tags.search</field>
        <field name="model">et.course.tags</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_et_course_tags" model="ir.actions.act_window">
        <field name="name">Course Tags</field>
        <field name="res_model">et.course.tags</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>