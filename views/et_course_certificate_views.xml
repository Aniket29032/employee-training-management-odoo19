<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================
            LIST VIEW
    ========================== -->

    <record id="view_et_course_certificate_list" model="ir.ui.view">
        <field name="name">et.course.certificate.list</field>
        <field name="model">et.course.certificate</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>
                <field name="employee_id"/>
                <field name="course_id"/>
                <field name="issue_date"/>

            </list>

        </field>
    </record>

    <!-- =========================
            FORM VIEW
    ========================== -->

    <record id="view_et_course_certificate_form" model="ir.ui.view">
        <field name="name">et.course.certificate.form</field>
        <field name="model">et.course.certificate</field>

        <field name="arch" type="xml">

            <form>

                <header>

                    <button
                        name="%(action_report_training_certificate)d"
                        string="Print Certificate"
                        type="action"
                        class="btn-primary"/>

                    <button
                        name="action_send_certificate_email"
                        string="Send Email"
                        type="object"
                        class="btn-secondary"
                        groups="employee_training_management.group_training_admin"/>

                </header>

                <sheet>

                    <group>

                        <group>

                            <field name="name" readonly="1"/>

                            <field name="employee_id"/>

                            <field name="course_id"/>

                        </group>

                        <group>

                            <field name="issue_date"/>

                            <field name="responsible_id"/>

                            <field name="company_id"/>

                        </group>

                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>

    <!-- =========================
            SEARCH VIEW
    ========================== -->

    <record id="view_et_course_certificate_search" model="ir.ui.view">
        <field name="name">et.course.certificate.search</field>
        <field name="model">et.course.certificate</field>

        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="employee_id"/>

                <field name="course_id"/>

                <separator/>

                <filter
                    string="Course"
                    name="group_course"
                    context="{'group_by':'course_id'}"/>

                <filter
                    string="Employee"
                    name="group_employee"
                    context="{'group_by':'employee_id'}"/>

            </search>

        </field>
    </record>

    <!-- =========================
            ACTION
    ========================== -->

    <record id="action_et_course_certificate"
            model="ir.actions.act_window">

        <field name="name">Certificates</field>

        <field name="res_model">et.course.certificate</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>