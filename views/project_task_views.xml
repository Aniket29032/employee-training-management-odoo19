<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- Training Task Form Inheritance -->
    <!-- ====================================================== -->

    <record id="view_project_task_training_form" model="ir.ui.view">
        <field name="name">project.task.training.form</field>
        <field name="model">project.task</field>

        <field name="inherit_id" ref="project.view_task_form2"/>

        <field name="arch" type="xml">

            <!-- =========================================== -->
            <!-- Status Bar -->
            <!-- =========================================== -->

            <xpath expr="//header" position="inside">

    <button
        name="action_start_work"
        type="object"
        string="Start Work"
        class="btn-primary"
        invisible="training_status != 'assigned'"/>

    

    <button
        name="action_submit_work"
        type="object"
        string="Submit Work"
        class="btn-success"
        invisible="training_status not in ('in_progress','rejected')"/>

    <button
        name="action_approve_work"
        type="object"
        string="Approve"
        class="btn-success"
        invisible="training_status != 'submitted'"
        groups="employee_training_management.group_training_trainer,employee_training_management.group_training_admin"/>

    <button
        name="action_reject_work"
        type="object"
        string="Reject"
        class="btn-danger"
        invisible="training_status != 'submitted'"
        groups="employee_training_management.group_training_trainer,employee_training_management.group_training_admin"/>

    <field
        name="training_status"
        widget="statusbar"
        statusbar_visible="assigned,in_progress,submitted,approved,rejected"/>

</xpath>


            <!-- =========================================== -->
            <!-- Training Information -->
            <!-- =========================================== -->

            <xpath expr="//sheet" position="inside">

                <group string="Training Task">

                    <group>

                        <field
                            name="training_session_id"
                            readonly="1"/>

                        <field name="training_status" widget="badge" decoration-success="training_status == 'approved'" decoration-danger="training_status == 'rejected'" decoration-warning="training_status == 'submitted'"/>

                        <field
                            name="submitted_on"
                            readonly="1"/>

                        <field
                            name="reviewed_on"
                            readonly="1"/>

                        <field
                            name="reviewed_by"
                            readonly="1"/>

                    </group>

                    <group>


                        <field
                            name="submission_file"
                            filename="submission_filename"
                            readonly="training_status not in ('in_progress','rejected')"/>

                        <field
                            name="submission_filename"
                            invisible="1"/>

                    </group>



                </group>

            </xpath>


            <!-- =========================================== -->
            <!-- Notebook -->
            <!-- =========================================== -->

            <xpath expr="//notebook" position="inside">

                <page string="Submission">

                    <group>

                        <field
                            name="submission_note"
                            readonly="training_status not in ('in_progress','rejected')"/>

                    </group>

                </page>

                <page string="Trainer Review">

                    <group>

                        <field
                            name="review_comment"
                            readonly="1"/>

                    </group>

                </page>

            </xpath>

        </field>

    </record>

</odoo>