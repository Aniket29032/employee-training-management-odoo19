<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- LIST VIEW -->
    <!-- ========================================================= -->

    <record id="view_et_session_attendance_list" model="ir.ui.view">
        <field name="name">et.session.attendance.list</field>
        <field name="model">et.session.attendance</field>
        <field name="arch" type="xml">

            <list
                decoration-success="status == 'present'"
                decoration-danger="status == 'absent'">

                <field name="trainee_employee_id"/>

                <field name="trainer_employee_id" optional="hide"/>

                <field name="course_id"/>

                <field name="session_id"/>

                <field name="attendance_date"/>


                <field
                    name="status"
                    widget="badge"
                    decoration-success="status == 'present'"
                    decoration-danger="status == 'absent'"/>

            </list>

        </field>
    </record>


    <!-- ========================================================= -->
    <!-- FORM VIEW -->
    <!-- ========================================================= -->

    <record id="view_et_session_attendance_form" model="ir.ui.view">
    <field name="name">et.session.attendance.form</field>
    <field name="model">et.session.attendance</field>

    <field name="arch" type="xml">

        <form>

            <header>

                <button
                    name="action_toggle_status"
                    type="object"
                    string="Mark Present"
                    class="btn-success"
                    invisible="status == 'present'"
                    groups="employee_training_management.group_training_trainer,employee_training_management.group_training_admin"/>

                <button
                    name="action_toggle_status"
                    type="object"
                    string="Mark Absent"
                    class="btn-danger"
                    invisible="status == 'absent'"
                    groups="employee_training_management.group_training_trainer,employee_training_management.group_training_admin"/>

                <field
                    name="status"
                    widget="statusbar"
                    statusbar_visible="present,absent"/>

            </header>

            <sheet>

                <group>

                    <group>

                        <field
                            name="trainee_employee_id"
                            readonly="1"/>

                        <field
                            name="course_id"
                            readonly="1"/>

                    </group>

                    <group>

                        <field
                            name="session_id"
                            readonly="1"/>

                        <field
                            name="trainer_employee_id"
                            readonly="1"/>

                        <field name="attendance_date"/>


                    </group>

                </group>

            </sheet>

            <chatter/>

        </form>

    </field>

</record>


    <!-- ========================================================= -->
    <!-- KANBAN -->
    <!-- ========================================================= -->

    <record id="view_et_session_attendance_kanban" model="ir.ui.view">
        <field name="name">et.session.attendance.kanban</field>
        <field name="model">et.session.attendance</field>

        <field name="arch" type="xml">

            <kanban>

                <field name="trainee_employee_id"/>
                <field name="trainer_employee_id"/>
                <field name="course_id"/>
                <field name="session_id"/>
                <field name="status"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_global_click">

                            <strong>
                                <field name="trainee_employee_id"/>
                            </strong>

                            <br/>

                            <b>Trainer :</b>
                            <field name="trainer_employee_id"/>

                            <br/>

                            <b>Course :</b>
                            <field name="course_id"/>

                            <br/>

                            <b>Session :</b>
                            <field name="session_id"/>

                            <br/>

                            <b>Status :</b>

                            <field
                                name="status"
                                widget="badge"/>

                            <br/>   

                            <b>Date :</b> 

                            <field name="attendance_date"/>


                        </div>

                    </t>

                </templates>

            </kanban>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- SEARCH VIEW -->
    <!-- ========================================================= -->

    <record id="view_et_session_attendance_search" model="ir.ui.view">
        <field name="name">et.session.attendance.search</field>
        <field name="model">et.session.attendance</field>

        <field name="arch" type="xml">

            <search>

                <field name="trainee_employee_id"/>
                <field name="trainer_employee_id"/>
                <field name="course_id"/>
                <field name="session_id"/>
                <field name="attendance_date"/>

                <separator/>

                <filter
                    string="Present"
                    name="present"
                    domain="[('status','=','present')]"/>

                <filter
                    string="Absent"
                    name="absent"
                    domain="[('status','=','absent')]"/>

                <separator/>

                <filter
                    string="Course"
                    name="group_course"
                    context="{'group_by':'course_id'}"/>

                <filter
                    string="Session"
                    name="group_session"
                    context="{'group_by':'session_id'}"/>

                <filter
                    string="Trainer"
                    name="group_trainer"
                    context="{'group_by':'trainer_employee_id'}"/>

                <filter
                    string="Employee"
                    name="group_employee"
                    context="{'group_by':'trainee_employee_id'}"/>

                <filter
                    string="Status"
                    name="group_status"
                    context="{'group_by':'status'}"/>

            </search>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- ACTION -->
    <!-- ========================================================= -->

    <record id="action_et_session_attendance" model="ir.actions.act_window">

        <field name="name">Attendance</field>

        <field name="res_model">et.session.attendance</field>

        <field name="view_mode">kanban,list,form</field>

    </record>

</odoo>