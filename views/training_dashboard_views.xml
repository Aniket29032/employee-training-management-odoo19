<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Training Dashboard -->
    <!-- ===================================================== -->

    <record id="view_training_dashboard_form" model="ir.ui.view">
        <field name="name">et.training.dashboard.form</field>
        <field name="model">et.training.dashboard</field>
        <field name="arch" type="xml">

            <form create="0" edit="0" delete="0">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            📊 Employee Training Dashboard
                        </h1>
                    </div>

                    <separator string="Overview"/>

                    <group col="6">

                        <group string="Courses">
                            <field name="course_count" readonly="1"/>
                        </group>

                        <group string="Sessions">
                            <field name="session_count" readonly="1"/>
                        </group>

                        <group string="Trainers">
                            <field name="trainer_count" readonly="1"/>
                        </group>

                        <group string="Trainees">
                            <field name="trainee_count" readonly="1"/>
                        </group>

                        <group string="Attendance">
                            <field name="attendance_count" readonly="1"/>
                        </group>

                        <group string="Certificates">
                            <field name="certificate_count" readonly="1"/>
                        </group>

                    </group>

                    <separator string="Course Status"/>

                    <group col="4">

                        <group string="Draft">
                            <field name="draft_courses" readonly="1"/>
                        </group>

                        <group string="Running">
                            <field name="running_courses" readonly="1"/>
                        </group>

                        <group string="Completed">
                            <field name="completed_courses" readonly="1"/>
                        </group>

                        <group string="Cancelled">
                            <field name="cancelled_courses" readonly="1"/>
                        </group>

                    </group>

                    <separator string="Task Status"/>

                    <group col="4">

                        <group string="Assigned">
                            <field name="assigned_tasks" readonly="1"/>
                        </group>

                        <group string="Submitted">
                            <field name="submitted_tasks" readonly="1"/>
                        </group>

                        <group string="Approved">
                            <field name="approved_tasks" readonly="1"/>
                        </group>

                        <group string="Rejected">
                            <field name="rejected_tasks" readonly="1"/>
                        </group>

                    </group>

                    <separator string="Pending Review"/>

                    <group>

                        <field
                            name="pending_review_count"
                            readonly="1"/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ===================================================== -->
    <!-- Action -->
    <!-- ===================================================== -->

    <record id="action_training_dashboard"
            model="ir.actions.act_window">

        <field name="name">Dashboard</field>

        <field name="res_model">et.training.dashboard</field>

        <field name="view_mode">form</field>

        <field name="target">current</field>

    </record>

</odoo>