<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_et_reject_wizard_form" model="ir.ui.view">
        <field name="name">et.reject.wizard.form</field>
        <field name="model">et.reject.wizard</field>

        <field name="arch" type="xml">

            <form string="Reject">

                <sheet>

                    <group>

                        <field name="reason"/>

                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_confirm_reject"
                        string="Confirm"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Discard"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>