<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- SESSION RULES                                         -->
    <!-- ===================================================== -->

    <!-- Employee -->
    <record id="rule_et_session_employee" model="ir.rule">
        <field name="name">ET Session Employee</field>
        <field name="model_id" ref="model_et_session"/>
        <field name="domain_force">
            [('trainee_employee_ids.user_id', '=', user.id)]
        </field>
        <field name="groups"
               eval="[(4, ref('employee_training_management.group_training_employee'))]"/>
    </record>

    <!-- Trainer -->
    <record id="rule_et_session_trainer" model="ir.rule">
        <field name="name">ET Session Trainer</field>
        <field name="model_id" ref="model_et_session"/>
        <field name="domain_force">
            [('trainer_employee_id.user_id', '=', user.id)]
        </field>
        <field name="groups"
               eval="[(4, ref('employee_training_management.group_training_trainer'))]"/>
    </record>

    <!-- Admin -->
    <record id="rule_et_session_admin" model="ir.rule">
        <field name="name">ET Session Admin</field>
        <field name="model_id" ref="model_et_session"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups"
               eval="[(4, ref('employee_training_management.group_training_admin'))]"/>
    </record>


