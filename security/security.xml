<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="group_training_employee" model="res.groups">
        <field name="name">Training Employee</field>
    </record>

    <record id="group_training_trainer" model="res.groups">
        <field name="name">Training Trainer</field>
        <field name="implied_ids"
               eval="[(4, ref('employee_training_management.group_training_employee'))]"/>
    </record>

    <record id="group_training_admin" model="res.groups">
        <field name="name">Training Administrator</field>
        <field name="implied_ids"
               eval="[(4, ref('employee_training_management.group_training_trainer'))]"/>
    </record>

</odoo>